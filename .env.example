# ==========================================
# RENDER + SUPABASE ENVIRONMENT VARIABLES
# Copy this file to .env (never commit .env!)
# ==========================================

# ── Database (Supabase PostgreSQL) ──────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database → Connection String
DB_URL=jdbc:postgresql://db.<your-supabase-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password

# ── JWT Secret ───────────────────────────────────────────────────
# Must be at least 32 characters long and kept secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# ── Frontend URL ─────────────────────────────────────────────────
# Set this to your Render static site URL (or custom domain)
# This is used for CORS and OAuth2 redirect
FRONTEND_URL=https://your-frontend.onrender.com

# ── Brevo Email API (PRIMARY — required for OTP emails) ──────────
# Sign up at https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
# Must be a verified sender in Brevo (Senders & Domains menu)
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=SHEPRENURE

# ── Google OAuth2 (optional — for Google Sign-in) ────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Set Authorized redirect URI to: https://your-backend.onrender.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Cloudinary (for product image uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Gmail SMTP (OPTIONAL — not used, all email goes through Brevo) ──
# Only fill these if you switch EmailService back to JavaMailSender
# GMAIL_USERNAME=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_google_app_password
