# ==========================================
# RENDER + SUPABASE ENVIRONMENT VARIABLES
# ==========================================

# Supabase PostgreSQL Connection Details
# Get these from Supabase Dashboard -> Project Settings -> Database -> Connection String
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-supabase-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Frontend Client URL (Your Render Static Site URL)
FRONTEND_URL=https://your-frontend.onrender.com

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/login/oauth2/code/google

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Mail Service (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_email_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
